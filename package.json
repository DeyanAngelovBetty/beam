{
  "name": "beam-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/sunlight",
    "storybook": "npm run storybook -w packages/beam",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.0"
  }
}
