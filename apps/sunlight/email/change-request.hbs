<!DOCTYPE html>
<!--
  Sunlight — Change Request approval-flow email.
  SOURCE: Tzeno's draft (2026-09-25). Structure KEPT verbatim (tables, MSO conditional, preheader, a11y
  scope/th, the equals / if / each branches) — this is a Beam-token RE-SKIN + bench, not a rebuild.
  Colours/typography/radii are email-safe LITERALS compiled from Beam tokens; the provenance table +
  rationale live in apps/sunlight/email/email-tokens.md. CONTRACT: every placeholder and conditional
  is unchanged — Tzeno's mailer consumes this file as-is. Client QA (Gmail/Outlook send-test) is a separate
  gate; the Storybook bench (Sunlight/Email — Change Request) is a visual harness only.
  NOTE: keep Handlebars tokens OUT of this comment — the parser reads mustaches inside HTML comments too.
-->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Change request #{{requestId}}</title>
  <style>
    @media only screen and (max-width:480px) {
      .email-stage { padding:16px 8px !important; }
      .email-content { padding:24px 20px !important; }
      .email-header, .email-footer { padding:18px 20px !important; }
      .email-headline { font-size:25px !important; }
    }
  </style>
</head>

<body style="margin:0;padding:0;background-color:#E2DDD9;font-family:Inter,Arial,Helvetica,sans-serif;color:#323232;">
  <div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;">
    Change request #{{requestId}} — {{status}}.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td align="center" class="email-stage" style="padding:32px 16px;">

        <!--[if mso]>
        <table role="presentation" width="600" cellpadding="0" cellspacing="0">
          <tr><td>
        <![endif]-->

        {{!-- border:1px solid #E9CEC2;border-radius:12px; --}}
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;border-collapse:separate;overflow:hidden;">

          <tr>
            <td class="email-header" bgcolor="#b33f00" 
              style="padding:22px 32px; border:1px solid #D08548; border-width:1px 1px 0 1px; border-radius:12px 12px 0 0; background: radial-gradient(80.51% 125.4% at 50% 100%, rgba(246, 242, 242, 0.81) 0%, rgba(246, 242, 242, 0.18) 100%), linear-gradient(0deg, rgba(179, 63, 0, 0.59) 0%, rgba(179, 63, 0, 0.59) 100%), #D5820B;

">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="font-size:34px;line-height:36px;letter-spacing:-2px;color:#b33f00;">

                    <img 
  style="width: 200px;" 
  src='data:image/png;base64,'/>



  {{!-- <div style="width: 200px;height: 31px;aspect-ratio: 200/31;background: url('data:image/png;base64,') lightgray 50% / contain no-repeat;
box-shadow: -0.5px -0.5px 0 0 rgba(222, 162, 78, 0.80) inset;"></div> --}}


                  </td>
                  <td align="right" style="font-size:14px;letter-spacing:1.6px;text-transform:uppercase;color:#fff; text-shadow: -0.5px 0.5px 0 0 rgba(222, 162, 78, 0.80)">
                    Change control
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td class="email-content" style="background-color:#F0F0F0; padding:30px 32px 28px; border:1px solid #E5BFA1; border-width:0 1px 1px 1px; border-radius:0 0 12px 12px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="table-layout:fixed;">

                <tr>
                  <td style="padding-bottom:18px;font-size:12px;line-height:24px;">

                    {{#equals status "Applied"}}
                    <span style="display:inline-block;padding:2px 10px;border-radius: 16px;color:#2e7d32;border: 1px solid #689F6B;letter-spacing: 0.5px;font-size:14px;font-weight:300;line-height:1.5;font-family: "Inter Variable", Helvetica, Arial, sans-serif;">
                      {{status}}
                    </span>
                    {{/equals}}

                    {{#equals status "Rejected"}}
                    <span style="display:inline-block;padding:2px 10px;border-radius:16px;color:#d32f2f;border:1px solid #DC6969;;letter-spacing: 0.5px;font-size:14px;font-weight:300;line-height:1.5;font-family: "Inter Variable", Helvetica, Arial, sans-serif;">
                      {{status}}
                    </span>
                    {{/equals}}

                    {{#equals status "Outdated"}}
                    <span style="display:inline-block;padding:2px 10px;border-radius:16px;color:#ed6c02;border:1px solid #F59E0B;letter-spacing: 0.5px;font-size:14px;font-weight:300;line-height:1.5;font-family: "Inter Variable", Helvetica, Arial, sans-serif;">
                      {{status}}
                    </span>
                    {{/equals}}

                    {{!-- <span style="padding-left:10px;color:#69636e;letter-spacing:0.5px;">
                      REQUEST #{{requestId}}
                    </span> --}}
                  </td>
                </tr>

                <tr>
                  <td style="background-color:#F0F0F0;">
                    <h1 class="email-headline" style="margin:0;font-size:28px;line-height:1.4;font-weight:normal;letter-spacing:-0.8px;">
                      {{#equals status "Applied"}}
                        Your change request was applied.
                      {{/equals}}
                      {{#equals status "Rejected"}}
                        Your change request was rejected.
                      {{/equals}}
                      {{#equals status "Outdated"}}
                        Your change request is outdated.
                      {{/equals}}
                    </h1>

                    <p style="margin:0;font-size:14px;line-height:23px;color:#787878;">
                      {{#equals status "Applied"}}
                        The changes you proposed have been successfully applied.
                      {{/equals}}
                      {{#equals status "Rejected"}}
                        The changes you proposed have not been applied. 
                      {{/equals}}
                      {{#equals status "Outdated"}}
                        Your request is no longer current and cannot be applied. 
                      {{/equals}}
                    </p>
                  </td>
                </tr>

                {{#equals status "Rejected"}}
                <tr>
                  <td style="padding-top:20px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td bgcolor="#fafafa" style="padding:17px 20px;border-radius:12px;border:1px solid #D08548;">
                          <h2 style="margin:0;font-size:16px;font-weight:600;line-height:28px;color:#323232;">
                            Reason
                          </h2>
                          <p style="margin-bottom:20px;font-size:17px;line-height:1.3;font-weight:200;white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word;">{{#if reason}}{{reason}}{{else}}No reason provided.{{/if}}</p>
                          {{#each appliedRequests}}
                          <p style="margin:4px 0 0;font-size:14px;line-height:23px;">
                            <a href="{{this.url}}" target="_blank" rel="noopener noreferrer" 
                              style="color: #B33F00;text-align: center;font-size: 13px;font-style: normal;font-weight: 550;line-height: 22px;letter-spacing: 0.46px;text-transform: uppercase; text-decoration: none;">
                              View applied change request #{{this.id}}
                            </a>
                          </p>
                          {{/each}}
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
                {{/equals}}

                {{#equals status "Outdated"}}
                <tr>
                  <td style="padding-top:24px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td bgcolor="#fafafa" style="padding:17px 20px;border-radius:12px;border:1px solid #D08548;">
                          <h2 style="margin:0;font-size:16px;font-weight:600;line-height:28px;color:#323232;">
                            Reason
                          </h2>
                          <p style="margin-bottom:20px;font-size:17px;line-height:1.2;font-weight:200;white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word;">{{#if reason}}{{reason}}{{else}}No reason provided.{{/if}}</p>
                          {{#each appliedRequests}}
                          <p style="margin:4px 0 0;font-size:14px;line-height:23px;">
                            <a href="{{this.url}}" target="_blank" rel="noopener noreferrer" 
                            style="color: #B33F00;text-align: center;font-size: 13px;font-style: normal;font-weight: 550;line-height: 22px;letter-spacing: 0.46px;text-transform: uppercase; text-decoration: none;">
                              View applied change request #{{this.id}}
                            </a>
                          </p>
                          {{/each}}
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
                {{/equals}}

                <tr>
                  <td style="padding-top:20px;">

                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td bgcolor="#EBEBEB" style="padding:17px 0 0 0;border-radius:12px;border:0.5px solid #D2CECB;">
                          <h2 style="padding: 0 20px;margin:0;font-size:16px;font-weight:600;line-height:28px;color:#323232;">
                            Details
                          </h2>

                          <p style="padding: 0 20px; margin-bottom:20px;font-size:17px;line-height:1.3;font-weight:200;white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word;">{{#if description}}{{description}}{{else}}Change request #{{requestId}}{{/if}}</p>

                          <table width="100%" cellpadding="0" cellspacing="0" aria-label="Change request details" style="font-size:13px;line-height:21px;">
                            <colgroup>
                              <col width="25%" />
                              <col width="75%" />
                            </colgroup>
                            <tr>
                              <th scope="row" align="left" 
                              style="color:#646464;border-top:0.5px solid #D2CECB;font-size: 10.4px;font-style: normal;font-weight: 300;line-height: 1;letter-spacing: 0.728px;text-transform: uppercase;padding:10px 0 10px 0;padding-left:20px;">
                                Feature
                              </th>
                              <td style="padding:10px 0;border-top:0.5px solid #D2CECB;overflow-wrap:anywhere;word-break:break-word;">
                                {{#if featureType}}{{featureType}}{{else}}Not provided{{/if}}
                              </td>
                            </tr>

                            <tr>
                              <th scope="row" align="left" style="color:#646464;border-top:0.5px solid #D2CECB;font-size: 10.4px;font-style: normal;font-weight: 300;line-height: 1;letter-spacing: 0.728px;text-transform: uppercase;padding:10px 0 10px 0;padding-left:20px;">
                                Updated by
                              </th>
                              <td style="padding:10px 0;border-top:0.5px solid #D2CECB;overflow-wrap:anywhere;word-break:break-word;">
                                {{#if updatedBy}}{{updatedBy}}{{else}}Not provided{{/if}}
                              </td>
                            </tr>

                            <tr>
                              <th scope="row" align="left" style="color:#646464;border-top:0.5px solid #D2CECB;font-size: 10.4px;font-style: normal;font-weight: 300;line-height: 1;letter-spacing: 0.728px;text-transform: uppercase;padding:10px 0 10px 0;padding-left:20px;  ">
                                Updated at
                              </th>
                              <td style="padding:10px 0;border-top:0.5px solid #D2CECB;overflow-wrap:anywhere;word-break:break-word;">
                                {{#if updatedAt}}{{updatedAt}}{{else}}Not provided{{/if}}
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>



                    {{!-- <p style="margin:0 0 9px;font-size:11px;line-height:18px;letter-spacing:1.3px;text-transform:uppercase;color:#69636e;">
                      Request details
                    </p> --}}


                  </td>
                </tr>

                <tr>
                  <td style="padding-top:24px;">
                    <table role="presentation" cellpadding="0" cellspacing="0">
                      <tr>
                        <td align="center" bgcolor="#b33f00" style="border-radius:8px;">
                          <a href="{{requestUrl}}" target="_blank" rel="noopener noreferrer" 
style="display:inline-block;padding:8px 16px;border-radius:8px;font-family:Inter,Arial,Helvetica,sans-serif;font-size:14px;letter-spacing: 1px;text-transform: uppercase;line-height:24px;text-decoration:none;color:#ffffff;">
                            View change request #{{requestId}}
                            {{!-- ➔ --}}
                          </a>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

              </table>
            </td>
          </tr>



        </table>

        <!--[if mso]>
          </td></tr>
        </table>
        <![endif]-->

      </td>
    </tr>
  </table>
</body>
</html>
